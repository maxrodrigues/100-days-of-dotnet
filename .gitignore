# .gitignore para projetos .NET / C#
# Ignora artefatos de build, arquivos de IDE e arquivos temporários do sistema

# Build
bin/
obj/
out/
artifacts/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# Rider / IntelliJ
.idea/
*.sln.iml

# Resharper
_ReSharper*/
*ReSharper*/
*.DotSettings.user
_ReSharper.Caches/

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/
project.assets.json
project.lock.json
project.fragment.lock.json

# Paket
.paket/

# Dotnet publish
publish/

# Test results
TestResults/
*.trx
*.coverage
coverage/
coverage*.xml

# Logs, dumps, caches
*.log
*.cache
*.pid
*.Seed/ # placeholder for temporary seed folders

# Runtime
*.dll
*.exe
*.pdb
*.mdb
*.class

# Rider caches
.idea/
*.suo

# User-specific files
*.userprefs
*.user
*.userosscache
*.sln.docstates

# Visual Studio profiler
*.vsp
*.vspx
*.sap

# Temporary files
*.tmp
*.temp
~$*

# OS files
.DS_Store
Thumbs.db

# Coverage / test tooling
coverage*
coverage/

# DotCover
*.dotCover

# OpenCover
*.opencover.xml

# dotnet tools
.toolstarget

# Azure Functions
.local.settings.json

# Ignore secrets file used by dotnet user-secrets (if present in repo by mistake)
secrets.json

# Others
# Rider local history
.idea/.idea_local_history

# End of file
